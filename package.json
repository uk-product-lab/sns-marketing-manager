{
  "name": "sns-marketing-manager",
  "version": "0.1.0",
  "private": true,
  "description": "A responsive foundation for the SNS Marketing Manager.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "setup:browsers": "playwright install chromium webkit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --reporter=verbose",
    "test:migration": "node scripts/test-d1-migrations.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:smoke": "npm run build && node scripts/test-smoke.mjs",
    "test:boundaries": "node scripts/test-boundaries.mjs",
    "quality": "npm run test:boundaries && npm run typecheck && npm run lint && npm run test:unit && npm run test:migration && npm run build && npm run test:e2e && npm run test:smoke"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.1",
    "wrangler": "^4.33.1"
  }
}
